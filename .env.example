# Select the server-side inference provider.
# Gemini has a free tier suitable for this hackathon MVP.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional future alternative. Standard Featherless API access requires a paid
# plan unless separate credits are provided; leave blank when using Gemini.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
