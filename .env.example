# Select the server-side inference provider.
# Gemini has a free tier suitable for this hackathon MVP.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional hackathon sponsor provider, validated with the pinned model below.
# Set AI_PROVIDER=featherless only when FEATHERLESS_API_KEY is configured.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
